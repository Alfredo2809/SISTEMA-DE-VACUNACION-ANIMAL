@startuml
skinparam classAttributeIconSize 0

' Enumeraciones
enum RolUsuario {
  ADMINISTRADOR
  BRIGADISTA
  PERSONAL_AUTORIZADO
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum Especie {
  PERRO
  GATO
}

enum EstadoMascota {
  ACTIVO
  FALLECIDO
  DESAPARECIDO
  OTRO
}

' Nuevo enumerador para manejar si fue vacunada o no en el mismo registro
enum EstadoVacunacion {
  VACUNADA
  NO_VACUNADA
}

' Entidades adaptadas a Convención Java
class Departamento <<entity>> {
  + idDepartamento: Long
  + nombre: String
}

class Municipio <<entity>> {
  + idMunicipio: Long
  + idDepartamento: Long
  + nombre: String
}

class Canton <<entity>> {
  + idCanton: Long
  + idMunicipio: Long
  + nombre: String
}

class Colonia <<entity>> {
  + idColonia: Long
  + idCanton: Long
  + nombre: String
}

class Vivienda <<entity>> {
  + idVivienda: Long
  + idColonia: Long
  + direccion: String
  + referenciaUbicacion: String
}

class Responsable <<entity>> {
  + idResponsable: Long
  + nombreCompleto: String
  + telefono: String
  + documentoIdentidad: String
}

class ViviendaResponsable <<entity>> {
  + idVivienda: Long
  + idResponsable: Long
}

class Mascota <<entity>> {
  + idMascota: Long
  + idResponsable: Long
  + idVivienda: Long
  + nombre: String
  + especie: Especie
  + fechaNacimiento: LocalDate
  + edadAproximadaMeses: Integer
  + estado: EstadoMascota
}

class Usuario <<entity>> {
  + idUsuario: Long
  + nombreCompleto: String
  + correo: String
  + contrasena: String
  + rol: RolUsuario
  + estado: EstadoUsuario
}

class CampanaVacunacion <<entity>> {
  + idCampana: Long
  + nombre: String
  + fechaInicio: LocalDate
  + fechaFin: LocalDate
  + estado: String
}

class CoberturaTerritorial <<entity>> {
  + idCobertura: Long
  + idCampana: Long
  + idColonia: Long
}

' Entidad unificada para los registros de vacunación (Vacunados y No Vacunados)
class RegistroVacunacion <<entity>> {
  + idRegistro: Long
  + idMascota: Long
  + idCampana: Long
  + idUsuario: Long
  + estado: EstadoVacunacion
  + fechaRegistro: LocalDateTime
  + motivoNoVacunacion: String
  + observaciones: String
}

' Relaciones Territoriales
Departamento "1" -- "0..*" Municipio : idDepartamento
Municipio "1" -- "0..*" Canton : idMunicipio
Canton "1" -- "0..*" Colonia : idCanton
Colonia "1" -- "0..*" Vivienda : idColonia
Colonia "1" -- "0..*" CoberturaTerritorial : idColonia

' Relaciones Vivienda y Responsable
Responsable "1" -- "0..*" ViviendaResponsable : idResponsable
Vivienda "1" -- "0..*" ViviendaResponsable : idVivienda

' Relaciones Mascotas
Responsable "1" -- "0..*" Mascota : idResponsable
Vivienda "1" -- "0..*" Mascota : idVivienda

' Relaciones Campaña
CampanaVacunacion "1" -- "0..*" CoberturaTerritorial : idCampana
CampanaVacunacion "1" -- "0..*" RegistroVacunacion : idCampana

' Relaciones Registros
Mascota "1" -- "0..*" RegistroVacunacion : idMascota
Usuario "1" -- "0..*" RegistroVacunacion : idUsuario

@enduml